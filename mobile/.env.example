# eMSME Mobile — Environment Variables
# Copy this to .env and fill in your values.
# IMPORTANT: Never commit .env — only commit .env.example

# eGovPH SSO (STAGING)
# Get these from the hackathon organizer or eGovPH developer portal
EXPO_PUBLIC_EGOV_PARTNER_CODE=your_partner_code_here
EXPO_PUBLIC_EGOV_SSO_URL=https://hackathon-sso.e.gov.ph

# Backend API URL — update to your machine's IP when testing on a physical device
# Do NOT use 'localhost' — the phone cannot reach your PC via localhost
EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
