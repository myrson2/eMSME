# eMSME Backend — Environment Variables
# Copy this to .env and fill in your values.
# IMPORTANT: Never commit .env — only commit .env.example

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change_this_to_a_random_secret_string

# eGovPH SSO (STAGING)
EGOV_BASE_URL=https://hackathon-sso.e.gov.ph
EGOV_PARTNER_CODE=your_partner_code_here
EGOV_PARTNER_SECRET=your_partner_secret_here

# eFace Liveness — Face liveness & biometric matching
# Leave both blank only to use the local staging mock.
EFACE_LIVENESS_API_URL=https://hackathon-face-liveness-api.e.gov.ph
EFACE_LIVENESS_API_KEY=

# eMessage — SMS OTP Gateway
# Leave blank to log OTP to console (dev mode)
EMESSAGE_API_URL=https://ws-message.e.gov.ph
EMESSAGE_API_TOKEN=

# Demo phone number for Smart Alert SMS (E.164 format)
DEMO_PHONE_NUMBER=+639000000000

# Database
DATABASE_URL=./emsme.sqlite

# eGovPay payment signing (use the staging value only for local development)
EGOVPAY_API_SECRET=staging_secret_key

# Business-verification adapters (leave blank for staging mock responses)
DTI_API_URL=
SEC_API_URL=
CDA_API_URL=
BIR_API_URL=
LGU_API_URL=
