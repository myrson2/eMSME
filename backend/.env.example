# eMSME Backend — Environment Variables
# Copy this to .env and fill in your values.
# IMPORTANT: Never commit .env — only commit .env.example

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change_this_to_a_random_secret_string

# eGovPH SSO (STAGING)
EGOV_CLIENT_ID=your_egov_client_id_here
EGOV_CLIENT_SECRET=your_egov_client_secret_here
EGOV_TOKEN_URL=https://staging-sso.egov.gov.ph/api/v1/oauth/token
EGOV_USERINFO_URL=https://staging-sso.egov.gov.ph/api/v1/oauth/userinfo
EGOV_REDIRECT_URI=emsme://auth/callback

# eFacial — Face Liveness & Biometric Matching
# Leave blank to use staging mock scores (liveness: 95%, match: 91%)
EFACIAL_API_URL=
EFACIAL_API_KEY=

# eMessage — SMS OTP Gateway
# Leave blank to log OTP to console (dev mode)
EMESSAGE_API_URL=
EMESSAGE_API_TOKEN=

# Database
DATABASE_URL=./emsme.sqlite
